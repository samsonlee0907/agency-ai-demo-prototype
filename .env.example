# Keep mock as the default. Set to live only after configuring credentials.
MODEL_MODE=mock
PORT=3000

# Azure OpenAI Responses API (server-side only)
GPT_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
# api-key or entra. Entra uses Azure CLI locally and managed identity in Azure.
GPT_AUTH_MODE=api-key
GPT_API_KEY=
GPT_DEPLOYMENT=gpt-5.6-terra

# Azure OpenAI Realtime API (managed identity / Entra only)
REALTIME_ENDPOINT=https://your-resource.cognitiveservices.azure.com
REALTIME_DEPLOYMENT=gpt-realtime-2.1

# Microsoft Foundry MAI image generation (can be a separate resource)
MAI_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
# api-key or entra
MAI_AUTH_MODE=api-key
MAI_API_KEY=
MAI_MODEL=MAI-Image-2.5
